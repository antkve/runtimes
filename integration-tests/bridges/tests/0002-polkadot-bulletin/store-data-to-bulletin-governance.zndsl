Description: Governance call to store data on Bulletin via People chain XCM
Network: {{ENV_PATH}}/polkadot_bulletin_local_network.toml
Creds: config

# Store data on Bulletin chain via governance XCM call from relay chain through People chain
alice-bulletin: run {{ENV_PATH}}/helper.sh with "auto-log store-data-to-bulletin ws://127.0.0.1:9942 //Alice 1004 ws://127.0.0.1:9910 ws://127.0.0.1:10000 {{DATA_FOR_BULLETIN}}" within 120 seconds
