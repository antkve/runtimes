Description: Governance call to add validator to Bulletin via People chain XCM
Network: {{ENV_PATH}}/people_polkadot_local_network.toml
Creds: config

# Add validator to Bulletin chain via governance XCM call from relay chain through People chain
alice: run {{ENV_PATH}}/helper.sh with "auto-log add-validator-to-bulletin ws://127.0.0.1:9942 //Alice 1004 ws://127.0.0.1:9910 ws://127.0.0.1:10000 5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY" within 120 seconds
