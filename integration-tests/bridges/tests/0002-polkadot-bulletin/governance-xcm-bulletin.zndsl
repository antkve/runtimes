Description: Comprehensive governance XCM calls to Bulletin chain via People chain
Network: {{ENV_PATH}}/people_polkadot_local_network.toml
Creds: config

# Test 1: Add validator to Bulletin chain via governance XCM call
alice: run {{ENV_PATH}}/helper.sh with "auto-log add-validator-to-bulletin ws://127.0.0.1:9942 //Alice 1004 ws://127.0.0.1:9910 ws://127.0.0.1:10000 5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY" within 120 seconds

# Test 2: Authorize account on Bulletin chain via governance XCM call  
alice: run {{ENV_PATH}}/helper.sh with "auto-log authorize-account-on-bulletin ws://127.0.0.1:9942 //Alice 1004 ws://127.0.0.1:9910 ws://127.0.0.1:10000 5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY" within 120 seconds

# Test 3: Store data on Bulletin chain via governance XCM call
alice: run {{ENV_PATH}}/helper.sh with "auto-log store-data-to-bulletin ws://127.0.0.1:9942 //Alice 1004 ws://127.0.0.1:9910 ws://127.0.0.1:10000 {{DATA_FOR_BULLETIN}}" within 120 seconds
